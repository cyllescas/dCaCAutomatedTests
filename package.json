{
  "name": "dcac-agentic-qa",
  "version": "1.0.0",
  "description": "QA agentic black-box para deCampoACampo con Cypress y Codex",
  "license": "ISC",
  "author": "dCaC",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "qa:agents:init": "playwright init-agents --loop=codex",
    "test": "cypress run",
    "test:all": "cypress run",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:sanity": "cypress run --env grepTags=@sanity",
    "qa:validate": "node scripts/validate-qa-contracts.cjs",
    "qa:validate:feature": "node scripts/validate-qa-contracts.cjs ofrecimientos-invernada"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "cypress": "^15.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
